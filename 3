import re

text = input("Enter a sentence: ")

words = re.findall(r"[a-zA-Z0-9']+", text.lower())

word_count = {}

for word in words:
    if word in word_count:
        word_count[word] += 1
    else:
        word_count[word] = 1

print("\nWord Count:")

for word, count in sorted(word_count.items()):
    print(word, count)
